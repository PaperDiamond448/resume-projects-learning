<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_dark"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button_dark"
                android:gravity="center"
                android:text="☰"
                android:textColor="#F2F5FA"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/topTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#F7F9FC"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/newConversationButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button_dark"
                android:gravity="center"
                android:text="+"
                android:textColor="#F2F5FA"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settingsToggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button_dark"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#F2F5FA"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/brainStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="弱传感器，强融合"
            android:textColor="#8791A8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wakeStatus"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill_dark"
                android:gravity="center"
                android:text="语音: 关闭"
                android:textColor="#D7DEEA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/visionStatus"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill_dark"
                android:gravity="center"
                android:text="视觉: 未开"
                android:textColor="#D7DEEA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accessibilityStatus"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill_dark"
                android:gravity="center"
                android:text="执行: 未开"
                android:textColor="#D7DEEA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <com.lingxi.mobile.ui.LingxiWakeIslandView
        android:id="@+id/wakeIsland"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:id="@+id/homeControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/wakeToggle"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button_dark"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/wake_off"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/wakeWordButton"
                android:layout_width="86dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_soft_button_dark"
                android:minHeight="0dp"
                android:text="@string/wake_word_btn"
                android:textAllCaps="false"
                android:textColor="#D7DEEA"
                android:textSize="13sp" />

            <Button
                android:id="@+id/screenVisionButton"
                android:layout_width="92dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_soft_button_dark"
                android:minHeight="0dp"
                android:text="屏幕视觉"
                android:textAllCaps="false"
                android:textColor="#D7DEEA"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/brainConnectionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button_dark"
            android:minHeight="0dp"
            android:text="云端大脑：未配置设备令牌"
            android:textAllCaps="false"
            android:textColor="#9FE8CC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/cloudVisionConsentButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button_dark"
            android:minHeight="0dp"
            android:text="云端截图：关闭（默认）"
            android:textAllCaps="false"
            android:textColor="#D7DEEA"
            android:textSize="14sp" />

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button_dark"
            android:minHeight="0dp"
            android:text="开启无障碍（操作 App 的手）"
            android:textAllCaps="false"
            android:textColor="#9FE8CC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/gazeCalibrationButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button_dark"
            android:minHeight="0dp"
            android:text="注视校准（看着谁说话需要先校准）"
            android:textAllCaps="false"
            android:textColor="#9FE8CC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/gazeTrackingButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button_dark"
            android:minHeight="0dp"
            android:text="注视追踪：关（点击开启小圆点跟随视线）"
            android:textAllCaps="false"
            android:textColor="#9FE8CC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/gazeTouchAssistButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button_dark"
            android:minHeight="0dp"
            android:text="触控辅助演示：关（仅用于明确标注的录制）"
            android:textAllCaps="false"
            android:textColor="#FFCC80"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/evidencePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_evidence_panel_dark"
            android:lineSpacingExtra="2dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="多模态证据会在这里出现：语音、点头/摇头、时间重叠与最终判断。"
            android:textColor="#B9C2D4"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_input_pill_dark"
            android:hint="@string/hint_input"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#F2F5FA"
            android:textColorHint="#8791A8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sendButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_button_dark"
            android:gravity="center"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
